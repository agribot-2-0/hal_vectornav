<?xml version="1.0"?>
<launch>

  <!-- Set arguments -->
  <arg name="ned_frame_id" default="vectornav_link_ned" />
  <arg name="enu_frame_id" default="chassis_link" />

  <arg name="serial_port" default="/dev/ttyUSB0" />
  <arg name="serial_baud" default="115200" />

  <arg name="async_output_rate" default="40" />
  <arg name="fixed_imu_rate" default="800" />


  <node pkg="hal_vectornav" type="hal_vectornav" name="hal_vectornav" output="screen">
    <!-- Load parameters -->
    <param name="ned_frame_id" value="$(arg ned_frame_id)" type="str" />
    <param name="enu_frame_id" value="$(arg enu_frame_id)" type="str" />

    <param name="serial_port" value="$(arg serial_port)" type="str" />
    <param name="serial_baud" value="$(arg serial_baud)" type="int" />

    <param name="async_output_rate" value="$(arg async_output_rate)" type="int" />
    <param name="fixed_imu_rate" value="$(arg fixed_imu_rate)" type="int" />

    <!-- Remap topics -->
    <remap from="~vectornav/imu/raw/data" to="/vectornav/imu/raw/data" />
    <remap from="~vectornav/imu/rotated/data" to="/vectornav/imu/rotated/data" />
    <remap from="~vectornav/imu/raw/mag" to="/vectornav/imu/raw/mag" />
    <remap from="~vectornav/imu/rotated/mag" to="/vectornav/imu/rotated/mag" />
    <remap from="~vectornav/gnss" to="/vectornav/gnss" />
  </node>

</launch>
